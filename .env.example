# OmniMind Environment Variables
# Copy this file to .env and fill in your values.
# Note: OmniMind uses stdio MCP — this file is for reference/tooling only.
# The variable below is passed via your MCP client config (see README).

# Required: Absolute path to your Obsidian vault (or any plain folder of Markdown files)
MASTERMIND_VAULT=/absolute/path/to/your/vault

# Examples:
# macOS:   MASTERMIND_VAULT=/Users/yourname/Documents/MyBrain
# Linux:   MASTERMIND_VAULT=/home/yourname/Documents/MyBrain
# Windows: MASTERMIND_VAULT=C:/Users/yourname/Documents/MyBrain
